#!/bin/sh
# Spread system traffic across every uplink with a default route.
# Adds one ECMP default route (metric 50) on top of NetworkManager's own
# per-device defaults, so NM keeps working and each new connection is hashed
# onto one link (per-flow, so a single TCP stream never changes IP mid-way).
case "$2" in up|down|dhcp4-change|connectivity-change) ;; *) exit 0 ;; esac
# NetworkManager rewrites the route metric a moment after it reports a
# connectivity change; read the routes only once that has settled.
[ "$2" = connectivity-change ] && sleep 3

hops=""
n=0
# NetworkManager adds 20000 to the metric of a link whose connectivity check
# fails (no internet, or a captive portal still waiting for a login). Leave
# those out, so half the connections do not die and the portal stays reachable
# through its own link; the dispatcher reruns on connectivity-change.
ip -4 route show default | grep '^default via' | while read -r line; do
  set -- $line
  metric=$(echo "$line" | sed -n 's/.* metric \([0-9]*\).*/\1/p')
  [ "${metric:-0}" -ge 20000 ] && continue
  echo "$3 $5"
done > /run/multipath-hops

while read -r gw dev; do
  [ -n "$gw" ] || continue
  hops="$hops nexthop via $gw dev $dev weight 1"
  n=$((n + 1))
done < /run/multipath-hops

ip -4 route del default metric 50 2>/dev/null
[ "$n" -ge 2 ] && ip -4 route add default metric 50 $hops
exit 0
